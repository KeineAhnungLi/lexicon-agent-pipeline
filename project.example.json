{
  "project_name": "production_lexicon",
  "repository_root": ".",
  "input_file": "local_inputs/words.tsv",
  "workspace": "workspace",
  "output_dir": "outputs/local",
  "prompt_template": "prompts/prompt_template.md",
  "review_prompt_template": "prompts/review_prompt_template.md",
  "generation_spec": "prompts/generation_spec.md",
  "examples": "examples/public_examples.jsonl",
  "agent_schema_file": "schemas/lexicon_agent_record.schema.json",
  "schema_file": "schemas/lexicon_record.schema.json",
  "batch_size": 200,
  "start_index": 1,
  "final_filename": "lexicon.ai-reviewed.jsonl",
  "agent_expected_fields": 29,
  "expected_fields": 30,
  "provider": "codex-cli",
  "provider_options": {
    "executable": "codex",
    "timeout_seconds": 3600,
    "max_validation_attempts": 2,
    "model": "gpt-5.6-sol",
    "reasoning_effort": "xhigh",
    "extra_args": ["--sandbox", "workspace-write", "--ephemeral"]
  }
}
