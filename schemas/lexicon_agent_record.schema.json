{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lexicon-agent-pipeline/lexicon_agent_record.schema.json",
  "title": "German Classics lexicon agent record (29 fields)",
  "description": "Generation and independent review contract. meaning_merged and example/sentence fields are intentionally absent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "first", "word", "spell_word", "class_options", "class", "change",
    "pronunciation", "correct_option",
    "meaning1", "collocation1", "collocation1_translation",
    "meaning2", "collocation2", "collocation2_translation",
    "meaning3", "collocation3", "collocation3_translation",
    "meaning4", "collocation4", "collocation4_translation",
    "meaning5", "collocation5", "collocation5_translation",
    "meaning6", "collocation6", "collocation6_translation",
    "meaning7", "collocation7", "collocation7_translation"
  ],
  "properties": {
    "first": { "type": "integer", "minimum": 1 },
    "word": { "type": "string", "minLength": 1 },
    "spell_word": { "type": "string", "minLength": 1 },
    "class_options": { "enum": ["N.", "V.", "Adj.", "others", "Wend."] },
    "class": {
      "type": "string",
      "pattern": "^(?:N\\.|V\\.|Adj\\.|Adv\\.|Präp\\.|Konj\\.|Pron\\.|Art\\.|Num\\.|Int\\.|Part\\.|Abk\\.|Wend\\.)(?:/(?:N\\.|V\\.|Adj\\.|Adv\\.|Präp\\.|Konj\\.|Pron\\.|Art\\.|Num\\.|Int\\.|Part\\.|Abk\\.|Wend\\.))*$"
    },
    "change": { "type": "string", "minLength": 1 },
    "pronunciation": { "type": "string", "minLength": 1 },
    "correct_option": { "type": "string", "minLength": 1 },
    "meaning1": { "type": "string", "minLength": 1, "not": { "const": "—" } },
    "collocation1": { "type": "string", "minLength": 1 },
    "collocation1_translation": { "type": "string", "minLength": 1 },
    "meaning2": { "type": "string", "minLength": 1 },
    "collocation2": { "type": "string", "minLength": 1 },
    "collocation2_translation": { "type": "string", "minLength": 1 },
    "meaning3": { "type": "string", "minLength": 1 },
    "collocation3": { "type": "string", "minLength": 1 },
    "collocation3_translation": { "type": "string", "minLength": 1 },
    "meaning4": { "type": "string", "minLength": 1 },
    "collocation4": { "type": "string", "minLength": 1 },
    "collocation4_translation": { "type": "string", "minLength": 1 },
    "meaning5": { "type": "string", "minLength": 1 },
    "collocation5": { "type": "string", "minLength": 1 },
    "collocation5_translation": { "type": "string", "minLength": 1 },
    "meaning6": { "type": "string", "minLength": 1 },
    "collocation6": { "type": "string", "minLength": 1 },
    "collocation6_translation": { "type": "string", "minLength": 1 },
    "meaning7": { "type": "string", "minLength": 1 },
    "collocation7": { "type": "string", "minLength": 1 },
    "collocation7_translation": { "type": "string", "minLength": 1 }
  }
}
